	<div class="input-label margin-bottom-0">
        <label for="modal-share-url">链接</label>
        <div class="position-relative">
            <input type="text" name="modal-share-url" id="modal-share-url" class="text-input" value="__url__" data-focus="select-all" readonly>
            <button type="button" class="input-action" data-action="copy" data-action-target="#modal-share-url" value=""><i class="far fa-copy"></i> 复制</button>
        </div>
    </div>
  	<br>
  	<div id="qrcode-url" style="display: flex; justify-content: center;"></div>
	<script type="text/javascript">
      (function () {
        function renderQr() {
          var el = document.getElementById("qrcode-url");
          var input = document.getElementById("modal-share-url");
          if (!el) return;
          var url = (input && input.value && input.value !== "__url__") ? input.value : window.location.href;
          if (!url || el.getAttribute("data-qr-url") === url) return;
          el.setAttribute("data-qr-url", url);
          el.innerHTML = "";
          try {
            new QRCode(el, {
              text: url,
              width: 150,
              height: 150,
              colorDark : "#6300DB",
              colorLight : "#FFFFFF",
              logo : "/content/images/system/favicon_1639686409730_363774.png",
              logoBackgroundTransparent : true,
              title : "MJJ.TODAY",
              titleFont : "bold 20px Arial",
              titleColor : "#FFFFFF",
              titleBackgroundColor : "#FFAA22",
              titleHeight : 25,
              titleTop : 20,
              tooltip : true
            });
          } catch (e) {
          }
        }
        var modal = document.getElementById("modal-share");
        if (modal && window.MutationObserver) {
          new MutationObserver(function () {
            if (!modal.classList.contains("hidden")) {
              setTimeout(renderQr, 50);
              setTimeout(renderQr, 300);
              setTimeout(renderQr, 800);
            }
          }).observe(modal, { attributes: true, attributeFilter: ["class"] });
        }
        document.addEventListener("click", function (e) {
          var target = e.target;
          if (target && target.closest && target.closest('[data-action="share"]')) {
            setTimeout(renderQr, 100);
            setTimeout(renderQr, 400);
          }
        }, true);
        renderQr();
      })();
    </script>
</div>
